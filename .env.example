# Required only for LLM-judge scorers (faithfulness, injection_resistance).
# Deterministic scorers (keyword_match, latency, tool_call_correctness) and
# all adapters work without this — target agents each have their own
# separate .env in their own repo/venv (see docs/architecture.md).
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional override, defaults to gemini-2.5-flash (see judge_llm.py for why
# not gemini-1.5-flash).
# AGENTSENTINEL_JUDGE_MODEL=gemini-2.5-flash
